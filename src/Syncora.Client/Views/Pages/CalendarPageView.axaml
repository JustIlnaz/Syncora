<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:Syncora.Client.ViewModels.Pages"
			 xmlns:pages="using:Syncora.Client.Views.Pages"
			 xmlns:dialogs="using:Syncora.Client.Views.Dialogs"
			 xmlns:conv="using:Syncora.Client.Converters"
			 xmlns:cal="using:Syncora.Client.Models.Calendar"
			 xmlns:sys="using:System"
			 x:Class="Syncora.Client.Views.Pages.CalendarPageView"
			 x:Name="Root"
			 x:DataType="vm:CalendarPageViewModel">

	<UserControl.Styles>
		<!-- Заголовок страницы -->
		<Style Selector="TextBlock.pageTitle">
			<Setter Property="FontSize" Value="22" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{DynamicResource LabelPrimary}" />
		</Style>

		<!-- Диалог создания календаря -->
		<Style Selector="Border.dialogOverlay">
			<Setter Property="Background" Value="#80000000" />
			<Setter Property="IsHitTestVisible" Value="True" />
		</Style>

		<!-- Кнопки навигации недели -->
		<Style Selector="Button.weekNav">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Padding" Value="10,6" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Foreground" Value="{DynamicResource LabelPrimary}" />
		</Style>
		<Style Selector="Button.weekNav:pointerover">
			<Setter Property="Background" Value="{DynamicResource SurfaceSecondary}" />
		</Style>

		<!-- Кнопка "Сегодня" -->
		<Style Selector="Button.todayBtn">
			<Setter Property="Background" Value="{DynamicResource AccentPurpleTint}" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Padding" Value="12,6" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Foreground" Value="{DynamicResource AccentPurpleDark}" />
			<Setter Property="FontWeight" Value="Medium" />
		</Style>
		<Style Selector="Button.todayBtn:pointerover">
			<Setter Property="Background" Value="{DynamicResource AccentPurpleLight}" />
		</Style>

		<!-- Primary/secondary/danger кнопки — глобальные стили, см. Styles/Buttons.axaml -->

		<!-- Заголовки дней недели -->
		<Style Selector="TextBlock.dayName">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Foreground" Value="{DynamicResource LabelSecondary}" />
			<Setter Property="HorizontalAlignment" Value="Center" />
		</Style>
		<Style Selector="TextBlock.dayNumber">
			<Setter Property="FontSize" Value="18" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{DynamicResource LabelPrimary}" />
			<Setter Property="HorizontalAlignment" Value="Center" />
		</Style>
		<Style Selector="TextBlock.dayNumber.today">
			<Setter Property="Foreground" Value="{DynamicResource AccentPurple}" />
		</Style>

		<!-- Часовые метки слева -->
		<Style Selector="TextBlock.hourLabel">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="FontWeight" Value="Medium" />
			<Setter Property="Foreground" Value="{DynamicResource LabelMuted}" />
			<Setter Property="HorizontalAlignment" Value="Right" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<Style Selector="Border.timeRail">
			<Setter Property="Background" Value="{DynamicResource SurfaceSecondary}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
			<Setter Property="BorderThickness" Value="0,0,1,0" />
		</Style>

		<Style Selector="Border.timeTick">
			<Setter Property="Height" Value="64" />
			<Setter Property="Padding" Value="0,0,12,0" />
		</Style>

		<!-- Ошибки/успех -->
		<Style Selector="TextBlock.errorText">
			<Setter Property="Foreground" Value="#D32F2F" />
			<Setter Property="FontSize" Value="13" />
		</Style>
		<Style Selector="TextBlock.successText">
			<Setter Property="Foreground" Value="#2E7D32" />
			<Setter Property="FontSize" Value="13" />
		</Style>

		<!-- Редактор события -->
		<Style Selector="TextBox.editorInput">
			<Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Padding" Value="10,8" />
		</Style>
		<Style Selector="ComboBox.editorInput">
			<Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Padding" Value="10,6" />
		</Style>

		<Style Selector="Button.colorSwatch">
			<Setter Property="Width" Value="30" />
			<Setter Property="Height" Value="30" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="CornerRadius" Value="15" />
			<Setter Property="Cursor" Value="Hand" />
		</Style>

		<Style Selector="Button.colorSwatch:pointerover">
			<Setter Property="Background" Value="{DynamicResource SurfaceSecondary}" />
		</Style>
	</UserControl.Styles>

	<Grid Background="{DynamicResource WindowBackground}"
		  RowDefinitions="Auto,Auto,*">

		<!-- ═══════ Заголовок ═══════ -->
		<Grid Grid.Row="0"
			  ColumnDefinitions="Auto,*,Auto"
			  Margin="0,0,0,16">

			<StackPanel Grid.Column="0" Spacing="2">
				<TextBlock Classes="pageTitle" Text="Календарь" />
				<TextBlock Text="{Binding WeekRangeText}"
						   FontSize="13"
						   Foreground="{DynamicResource LabelSecondary}" />
			</StackPanel>

			<StackPanel Grid.Column="2"
						Orientation="Horizontal"
						Spacing="8"
						VerticalAlignment="Center">
				<Button Classes="weekNav" Command="{Binding PreviousWeekCommand}">
					<TextBlock Text="‹" FontSize="16" />
				</Button>
				<Button Classes="todayBtn" Command="{Binding TodayCommand}">
					Сегодня
				</Button>
				<Button Classes="weekNav" Command="{Binding NextWeekCommand}">
					<TextBlock Text="›" FontSize="16" />
				</Button>
				<Button Classes="primaryBtn" Command="{Binding OpenCreateEditorCommand}" Margin="8,0,0,0">
					+ Событие
				</Button>
				<Button Classes="primaryBtn" Command="{Binding OpenCreateCalendarDialogCommand}" Margin="8,0,0,0">
					+ Календарь
				</Button>
			</StackPanel>
		</Grid>

		<!-- ═══════ Сообщения ═══════ -->
		<StackPanel Grid.Row="1" Margin="0,0,0,8">
			<TextBlock Classes="errorText"
					   Text="{Binding ErrorMessage}"
					   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
			<TextBlock Classes="successText"
					   Text="{Binding SuccessMessage}"
					   IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
		</StackPanel>

		<!-- ═══════ Основная область ═══════ -->
		<Grid Grid.Row="2"
			  ColumnDefinitions="260,*,Auto"
			  ColumnSpacing="16">

			<!-- ═══════ Левая панель: Мои календари ═══════ -->
			<Border Grid.Column="0"
					Background="{DynamicResource SurfaceBackground}"
					CornerRadius="16"
					BoxShadow="0 2 12 0 #14000000"
					Padding="16">
				<StackPanel Spacing="12">
					<TextBlock Text="Мои календари"
							   FontSize="16"
							   FontWeight="SemiBold"
							   Foreground="{DynamicResource LabelPrimary}" />

					<ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400">
						<ItemsControl ItemsSource="{Binding CalendarItems}">
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="vm:CalendarItemViewModel">
									<Border Padding="8,6"
											CornerRadius="8"
											Margin="0,0,0,4">
										<Grid ColumnDefinitions="Auto,*,Auto">
											<CheckBox Grid.Column="0"
													  IsChecked="{Binding IsVisible}"
													  VerticalAlignment="Center"
													  Margin="0,0,8,0">
												<CheckBox.Content>
													<Ellipse Width="12" Height="12"
															 Fill="{Binding Color}" />
												</CheckBox.Content>
											</CheckBox>
											<StackPanel Grid.Column="1" Spacing="1">
												<Button Background="Transparent"
														BorderThickness="0"
														Padding="0"
														Cursor="Hand"
														HorizontalAlignment="Stretch"
														HorizontalContentAlignment="Left"
														Command="{Binding $parent[UserControl].((vm:CalendarPageViewModel)DataContext).SelectCalendarCommand}"
														CommandParameter="{Binding}">
													<StackPanel Spacing="1">
														<TextBlock Text="{Binding Name}"
																   FontSize="13"
																   FontWeight="Medium"
																   Foreground="{DynamicResource LabelPrimary}"
																   TextTrimming="CharacterEllipsis" />
														<TextBlock Text="{Binding TypeDisplayName}"
																   FontSize="11"
																   Foreground="{DynamicResource LabelMuted}" />
													</StackPanel>
												</Button>
											</StackPanel>
											<Button Grid.Column="2"
													Content="⋯"
													FontSize="14"
													Padding="4,2"
													Background="Transparent"
													BorderThickness="0"
													Foreground="{DynamicResource LabelSecondary}"
													Cursor="Hand"
													Command="{Binding $parent[UserControl].((vm:CalendarPageViewModel)DataContext).SelectCalendarCommand}"
													CommandParameter="{Binding}"
													IsVisible="{Binding IsOwner}" />
										</Grid>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>

					<!-- Информация о выбранном календаре и управление им -->
					<Border Background="{DynamicResource SurfaceSecondary}"
							CornerRadius="8"
							Padding="12"
							IsVisible="{Binding SelectedCalendar, Converter={x:Static ObjectConverters.IsNotNull}}">
						<StackPanel Spacing="6">
							<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
								<Ellipse Width="12" Height="12"
										 Fill="{Binding SelectedCalendar.Color}"
										 VerticalAlignment="Center" />
								<TextBlock Text="{Binding SelectedCalendar.Name}"
										   FontSize="14"
										   FontWeight="SemiBold"
										   Foreground="{DynamicResource LabelPrimary}"
										   TextTrimming="CharacterEllipsis" />
							</StackPanel>
							<TextBlock Text="{Binding SelectedCalendar.TypeDisplayName}"
									   FontSize="12"
									   Foreground="{DynamicResource LabelSecondary}" />
							<TextBlock Text="{Binding SelectedCalendar.Description}"
									   FontSize="12"
									   Foreground="{DynamicResource LabelMuted}"
									   TextWrapping="Wrap"
									   IsVisible="{Binding SelectedCalendar.Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
							<TextBlock Text="{Binding SelectedCalendarMembersCountText}"
									   FontSize="12"
									   Foreground="{DynamicResource LabelMuted}"
									   IsVisible="{Binding SelectedCalendarHasMembers}" />
							<TextBlock Text="Личный календарь нельзя удалить"
									   FontSize="11"
									   Foreground="{DynamicResource LabelMuted}"
									   FontStyle="Italic"
									   IsVisible="{Binding IsSelectedCalendarPersonal}" />
							<Button Content="Редактировать"
									Classes="weekNav"
									Command="{Binding OpenCalendarEditCommand}"
									IsVisible="{Binding CanManageSelectedCalendar}" />
						</StackPanel>
					</Border>
				</StackPanel>
			</Border>

			<!-- Недельный календарь -->
			<Border Grid.Column="1"
					Background="{DynamicResource SurfaceBackground}"
					CornerRadius="16"
					BoxShadow="0 2 12 0 #14000000"
					Padding="0"
					ClipToBounds="True">

				<Grid RowDefinitions="Auto,*">

					<!-- Заголовок месяца + дни недели -->
					<Grid Grid.Row="0"
						  ColumnDefinitions="72,*"
						  RowDefinitions="Auto,Auto"
						  Margin="0,16,0,0">

						<TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
								   Text="{Binding MonthTitle}"
								   FontSize="16"
								   FontWeight="SemiBold"
								   Foreground="{DynamicResource LabelPrimary}"
								   Margin="16,0,16,12" />

						<!-- Пустой угол -->
						<Border Grid.Row="1" Grid.Column="0"
								Classes="timeRail"
								BorderBrush="{DynamicResource BorderSoft}"
								BorderThickness="0,0,1,1" />

						<!-- Дни недели -->
						<ItemsControl Grid.Row="1" Grid.Column="1"
									  ItemsSource="{Binding Days}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<UniformGrid Columns="7" />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="vm:WeekDayColumnViewModel">
									<Border BorderBrush="{DynamicResource BorderSoft}"
											BorderThickness="0,0,1,1"
											Padding="4,8">
										<StackPanel Spacing="2">
											<TextBlock Classes="dayName" Text="{Binding DayName}" />
											<TextBlock Classes="dayNumber"
													   Classes.today="{Binding IsToday}"
													   Text="{Binding DayNumber}" />
										</StackPanel>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</Grid>

					<!-- Тело календаря -->
					<ScrollViewer Grid.Row="1"
								  x:Name="CalendarScroll"
								  VerticalScrollBarVisibility="Auto"
								  HorizontalScrollBarVisibility="Disabled">
						<Grid ColumnDefinitions="72,*"
							  Width="{Binding #CalendarScroll.Bounds.Width}">

							<!-- Часовые метки -->
							<Border Grid.Column="0"
									Classes="timeRail">
								<ItemsControl
										  ItemsSource="{Binding HourLabels}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<StackPanel />
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="sys:String">
											<Border Classes="timeTick">
												<TextBlock Classes="hourLabel"
														   Text="{Binding}" />
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</Border>

							<!-- Колонки дней -->
							<ItemsControl Grid.Column="1"
										  ItemsSource="{Binding Days}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<UniformGrid Columns="7" />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:WeekDayColumnViewModel">
										<pages:DayColumnView DayColumn="{Binding}"
															 OpenEventCommand="{Binding #Root.((vm:CalendarPageViewModel)DataContext).OpenEditEditorCommand}" />
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</Grid>
					</ScrollViewer>
				</Grid>
			</Border>

			<!-- ═══════ Правая панель: редактор события ═══════ -->
			<Border Grid.Column="2"
					Width="320"
					Background="{DynamicResource SurfaceBackground}"
					CornerRadius="16"
					BoxShadow="0 2 12 0 #14000000"
					Padding="20"
					IsVisible="{Binding IsEditorOpen}">
				<Grid RowDefinitions="Auto,*,Auto">
					<StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
						<TextBlock FontSize="18"
								   FontWeight="SemiBold"
								   Foreground="{DynamicResource LabelPrimary}">
							<TextBlock.IsVisible>
								<Binding Path="IsEditingExisting" />
							</TextBlock.IsVisible>
							Редактировать событие
						</TextBlock>
						<TextBlock Text="Новое событие"
								   FontSize="18"
								   FontWeight="SemiBold"
								   Foreground="{DynamicResource LabelPrimary}">
							<TextBlock.IsVisible>
								<Binding Path="!IsEditingExisting" />
							</TextBlock.IsVisible>
						</TextBlock>
					</StackPanel>

					<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
						<StackPanel Spacing="12">
							<!-- Название -->
							<StackPanel Spacing="4">
								<TextBlock Text="Название"
										   FontSize="12"
										   Foreground="{DynamicResource LabelSecondary}" />
								<TextBox Classes="editorInput"
										 Text="{Binding EditTitle}"
										 Watermark="Введите название" />
							</StackPanel>

							<!-- Описание -->
							<StackPanel Spacing="4">
								<TextBlock Text="Описание"
										   FontSize="12"
										   Foreground="{DynamicResource LabelSecondary}" />
								<TextBox Classes="editorInput"
										 Text="{Binding EditDescription}"
										 Watermark="Детали события (необязательно)"
										 AcceptsReturn="True"
										 Height="88"
										 TextWrapping="Wrap" />
							</StackPanel>

							<!-- Календарь -->
							<StackPanel Spacing="4">
								<TextBlock Text="Календарь"
										   FontSize="12"
										   Foreground="{DynamicResource LabelSecondary}" />
								<ComboBox Classes="editorInput"
										  ItemsSource="{Binding Calendars}"
										  SelectedItem="{Binding EditCalendar}"
										  HorizontalAlignment="Stretch">
									<ComboBox.ItemTemplate>
										<DataTemplate x:DataType="cal:CalendarDto">
											<StackPanel Orientation="Horizontal" Spacing="8">
												<Border Width="10"
														Height="10"
														CornerRadius="5"
														Background="{Binding Color, Converter={x:Static conv:HexToBrushConverter.Instance}}"
														VerticalAlignment="Center" />
												<TextBlock Text="{Binding Name}" />
											</StackPanel>
										</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>
							</StackPanel>

							<!-- Цвет события -->
							<StackPanel Spacing="8">
								<TextBlock Text="Цвет события"
										   FontSize="12"
										   Foreground="{DynamicResource LabelSecondary}" />
								<ItemsControl ItemsSource="{Binding EventColors}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<WrapPanel />
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="vm:EventColorOptionViewModel">
											<Button Classes="colorSwatch"
													Command="{Binding #Root.((vm:CalendarPageViewModel)DataContext).SelectEventColorCommand}"
													CommandParameter="{Binding}"
													ToolTip.Tip="{Binding Name}"
													Margin="0,0,6,6">
												<Grid>
													<Border Width="24"
															Height="24"
															CornerRadius="12"
															Background="{Binding Hex, Converter={x:Static conv:HexToBrushConverter.Instance}}"
															HorizontalAlignment="Center"
															VerticalAlignment="Center"
															BoxShadow="0 1 5 0 #22000000" />
													<Border Width="30"
															Height="30"
															CornerRadius="15"
															BorderBrush="{DynamicResource LabelPrimary}"
															BorderThickness="2"
															IsVisible="{Binding IsSelected}" />
													<TextBlock Text="✓"
															   FontSize="12"
															   FontWeight="Bold"
															   Foreground="White"
															   HorizontalAlignment="Center"
															   VerticalAlignment="Center"
															   IsVisible="{Binding IsSelected}" />
												</Grid>
											</Button>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>

							<!-- Дата -->
							<StackPanel Spacing="4">
								<TextBlock Text="Дата"
										   FontSize="12"
										   Foreground="{DynamicResource LabelSecondary}" />
								<CalendarDatePicker SelectedDate="{Binding EditDate}"
													Watermark="Выберите дату" />
							</StackPanel>

							<!-- Время начала -->
							<StackPanel Spacing="4">
								<TextBlock Text="Время начала"
										   FontSize="12"
										   Foreground="{DynamicResource LabelSecondary}" />
								<TimePicker SelectedTime="{Binding EditStartTime}"
											HorizontalAlignment="Stretch" />
							</StackPanel>

							<!-- Время окончания -->
							<StackPanel Spacing="4">
								<TextBlock Text="Время окончания"
										   FontSize="12"
										   Foreground="{DynamicResource LabelSecondary}" />
								<TimePicker SelectedTime="{Binding EditEndTime}"
											HorizontalAlignment="Stretch" />
							</StackPanel>

							<!-- Принявшие встречу -->
							<StackPanel Spacing="6"
										IsVisible="{Binding HasAcceptedParticipants}">
								<TextBlock FontSize="12"
										   Foreground="{DynamicResource LabelSecondary}">
									<Run Text="Приняли участие (" />
									<Run Text="{Binding EditAcceptedParticipants.Count}" />
									<Run Text=")" />
								</TextBlock>
								<ItemsControl ItemsSource="{Binding EditAcceptedParticipants}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<WrapPanel Orientation="Horizontal" />
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="sys:String">
											<Border Background="{DynamicResource AccentPurpleTint}"
													CornerRadius="12"
													Padding="8,4"
													Margin="0,0,6,6">
												<TextBlock FontSize="12"
														   Foreground="{DynamicResource AccentPurpleDark}">
													<Run Text="✓ " />
													<Run Text="{Binding}" />
												</TextBlock>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</StackPanel>
					</ScrollViewer>

					<!-- Кнопки редактора -->
					<StackPanel Grid.Row="2"
								Spacing="8"
								Margin="0,16,0,0">
						<Button Classes="primaryBtn"
								Content="Сохранить"
								Command="{Binding SaveEventCommand}"
								IsEnabled="{Binding !IsEditorBusy}"
								HorizontalAlignment="Stretch" />
						<Button Content="Отмена"
								Classes="secondaryBtn"
								Command="{Binding CloseEditorCommand}"
								HorizontalAlignment="Stretch" />
						<Button Content="Удалить"
								Classes="dangerBtn"
								Command="{Binding DeleteEventCommand}"
								IsVisible="{Binding IsEditingExisting}"
								HorizontalAlignment="Stretch" />
					</StackPanel>
				</Grid>
			</Border>
		</Grid>

		<!-- Диалог создания календаря -->
		<Border Grid.RowSpan="3"
				Classes="dialogOverlay"
				IsVisible="{Binding IsCreateCalendarDialogOpen}"
				ZIndex="1000">
			<Border HorizontalAlignment="Center"
					VerticalAlignment="Center">
				<ContentControl Content="{Binding CreateCalendarDialog}" />
			</Border>
		</Border>

		<!-- Диалог редактирования календаря + участники -->
		<Border Grid.RowSpan="3"
				Classes="dialogOverlay"
				IsVisible="{Binding IsCalendarEditOpen}"
				ZIndex="1000">
			<Border HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Background="{DynamicResource WindowBackground}"
					CornerRadius="16"
					BoxShadow="0 8 32 0 #1A000000"
					Padding="32"
					Width="480">
				<StackPanel Spacing="16">
					<TextBlock Text="Настройки календаря"
							   FontSize="18"
							   FontWeight="SemiBold"
							   Foreground="{DynamicResource LabelPrimary}" />

					<!-- Название -->
					<StackPanel Spacing="6">
						<TextBlock Text="Название"
								   FontSize="13"
								   Foreground="{DynamicResource LabelSecondary}" />
						<TextBox Text="{Binding EditCalendarName}"
								 Background="{DynamicResource SurfaceBackground}"
								 BorderBrush="{DynamicResource BorderSoft}"
								 CornerRadius="8"
								 Padding="12,10" />
					</StackPanel>

					<!-- Цвет -->
					<StackPanel Spacing="6">
						<TextBlock Text="Цвет"
								   FontSize="13"
								   Foreground="{DynamicResource LabelSecondary}" />
						<ItemsControl ItemsSource="{Binding EventColors}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<WrapPanel />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="vm:EventColorOptionViewModel">
									<Button Width="32" Height="32"
											Padding="0"
											Background="Transparent"
											CornerRadius="16"
											Cursor="Hand"
											Margin="0,0,8,8"
											BorderBrush="{DynamicResource AccentPurple}"
											BorderThickness="0"
											Command="{Binding $parent[UserControl].((vm:CalendarPageViewModel)DataContext).SelectCalendarColorCommand}"
											CommandParameter="{Binding}">
										<Border Width="24" Height="24"
												CornerRadius="12"
												Background="{Binding Hex}"
												HorizontalAlignment="Center"
												VerticalAlignment="Center" />
									</Button>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>

					<!-- Участники (только для группового) -->
					<StackPanel Spacing="8"
								IsVisible="{Binding IsSelectedCalendarGroup}">
						<TextBlock Text="Участники"
								   FontSize="14"
								   FontWeight="SemiBold"
								   Foreground="{DynamicResource LabelPrimary}" />

						<ItemsControl ItemsSource="{Binding SelectedCalendar.Members}">
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="cal:CalendarMemberDto">
									<Border Padding="0,4"
											BorderBrush="{DynamicResource BorderSoft}"
											BorderThickness="0,0,0,1">
										<Grid ColumnDefinitions="*,Auto,Auto">
											<StackPanel Grid.Column="0" Spacing="1">
												<TextBlock Text="{Binding UserName}"
														   FontSize="13"
														   Foreground="{DynamicResource LabelPrimary}" />
												<TextBlock Text="{Binding Email}"
														   FontSize="11"
														   Foreground="{DynamicResource LabelMuted}" />
											</StackPanel>
											<ComboBox Grid.Column="1"
													  SelectedValue="{Binding AccessLevel}"
													  SelectedValueBinding="{Binding Value}"
													  Width="140"
													  Margin="8,0,8,0"
													  HorizontalAlignment="Right">
												<ComboBox.ItemsSource>
													<Binding Path="$parent[UserControl].((vm:CalendarPageViewModel)DataContext).AccessLevels" />
												</ComboBox.ItemsSource>
												<ComboBox.ItemTemplate>
													<DataTemplate x:DataType="vm:AccessLevelOption">
														<TextBlock Text="{Binding DisplayName}" FontSize="12" />
													</DataTemplate>
												</ComboBox.ItemTemplate>
											</ComboBox>
											<Button Grid.Column="2"
													Content="✕"
													FontSize="12"
													Padding="6,2"
													Background="Transparent"
													BorderThickness="0"
													Foreground="#D32F2F"
													Cursor="Hand"
													Command="{Binding $parent[UserControl].((vm:CalendarPageViewModel)DataContext).RemoveMemberCommand}"
													CommandParameter="{Binding}" />
										</Grid>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>

						<!-- Добавить участника -->
						<Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,0">
							<TextBox Grid.Column="0"
									 Text="{Binding NewMemberEmail}"
									 Watermark="Email пользователя"
									 Background="{DynamicResource SurfaceBackground}"
									 BorderBrush="{DynamicResource BorderSoft}"
									 CornerRadius="8"
									 Padding="10,8"
									 Margin="0,0,8,0" />
							<ComboBox Grid.Column="1"
									  ItemsSource="{Binding AccessLevels}"
									  SelectedItem="{Binding NewMemberAccessLevel}"
									  PlaceholderText="Права"
									  Width="140"
									  Margin="0,0,8,0">
								<ComboBox.ItemTemplate>
									<DataTemplate x:DataType="vm:AccessLevelOption">
										<TextBlock Text="{Binding DisplayName}" FontSize="12" />
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
							<Button Grid.Column="2"
									Content="Добавить"
									Classes="primaryBtn"
									Command="{Binding AddMemberCommand}" />
						</Grid>
					</StackPanel>

					<!-- Кнопки -->
					<StackPanel Orientation="Horizontal"
								Spacing="12"
								HorizontalAlignment="Right"
								Margin="0,8,0,0">
						<Button Content="Удалить"
								Classes="dangerBtn"
								IsVisible="{Binding CanDeleteSelectedCalendar}"
								Command="{Binding DeleteCalendarCommand}" />
						<Button Content="Отмена"
								Classes="secondaryBtn"
								Command="{Binding CloseCalendarEditCommand}" />
						<Button Content="Сохранить"
								Classes="primaryBtn"
								Command="{Binding SaveCalendarCommand}"
								IsEnabled="{Binding !IsCalendarBusy}" />
					</StackPanel>
				</StackPanel>
			</Border>
		</Border>
	</Grid>
</UserControl>

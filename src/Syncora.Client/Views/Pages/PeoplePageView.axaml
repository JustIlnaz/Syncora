<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:Syncora.Client.ViewModels.Pages"
			 xmlns:um="using:Syncora.Client.Models.User"
			 xmlns:cm="using:Syncora.Client.Models.Calendar"
			 x:Class="Syncora.Client.Views.Pages.PeoplePageView"
			 x:Name="Root"
			 x:DataType="vm:PeoplePageViewModel">

	<UserControl.Styles>
		<Style Selector="TextBlock.pageTitle">
			<Setter Property="FontSize" Value="22" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{DynamicResource LabelPrimary}" />
		</Style>

		<!-- Стили кнопок primaryBtn/secondaryBtn/dangerBtn — глобальные, см. Styles/Buttons.axaml -->

		<Style Selector="TextBlock.sectionTitle">
			<Setter Property="FontSize" Value="16" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{DynamicResource LabelPrimary}" />
		</Style>

		<Style Selector="TextBlock.errorText">
			<Setter Property="Foreground" Value="#D32F2F" />
			<Setter Property="FontSize" Value="13" />
		</Style>
		<Style Selector="TextBlock.successText">
			<Setter Property="Foreground" Value="#2E7D32" />
			<Setter Property="FontSize" Value="13" />
		</Style>

		<Style Selector="TextBox.input">
			<Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Padding" Value="10,8" />
		</Style>

		<Style Selector="Border.personCard">
			<Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
			<Setter Property="CornerRadius" Value="12" />
			<Setter Property="BoxShadow" Value="0 2 12 0 #14000000" />
			<Setter Property="Padding" Value="14,12" />
		</Style>
	</UserControl.Styles>

	<Grid Background="{DynamicResource WindowBackground}"
		  RowDefinitions="Auto,Auto,*">

		<!-- ═══════ Заголовок ═══════ -->
		<Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16">
			<TextBlock Classes="pageTitle" Text="Люди" Grid.Column="0" />
			<Button Grid.Column="2"
					Classes="primaryBtn"
					Content="+ Добавить контакт"
					Command="{Binding OpenAddContactCommand}" />
		</Grid>

		<!-- Сообщения -->
		<StackPanel Grid.Row="1" Margin="0,0,0,8">
			<TextBlock Classes="errorText" Text="{Binding ErrorMessage}"
					   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
			<TextBlock Classes="successText" Text="{Binding SuccessMessage}"
					   IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
		</StackPanel>

		<!-- ═══════ Контент ═══════ -->
		<Grid Grid.Row="2" ColumnDefinitions="*,16,*">

			<!-- Левая колонка: мои контакты -->
			<ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
				<StackPanel Spacing="8">
					<TextBlock Classes="sectionTitle" Text="Мои контакты" Margin="0,0,0,4" />

					<ItemsControl ItemsSource="{Binding Contacts}">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="um:ContactDto">
								<Border Classes="personCard" Margin="0,0,0,8">
									<Grid ColumnDefinitions="*,Auto">
										<StackPanel Grid.Column="0" Spacing="2">
											<TextBlock Text="{Binding Name}"
													   FontSize="14"
													   FontWeight="SemiBold"
													   Foreground="{DynamicResource LabelPrimary}" />
											<TextBlock Text="{Binding Nickname}"
													   FontSize="12"
													   Foreground="{DynamicResource LabelMuted}"
													   IsVisible="{Binding Nickname, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
											<TextBlock Text="{Binding Email}"
													   FontSize="13"
													   Foreground="{DynamicResource LabelSecondary}" />
											<TextBlock Text="{Binding Timezone, StringFormat='Часовой пояс: {0}'}"
													   FontSize="12"
													   Foreground="{DynamicResource LabelMuted}"
													   IsVisible="{Binding Timezone, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
										</StackPanel>
										<Button Grid.Column="1"
												Classes="dangerBtn iconBtn"
												Content="✕"
												Command="{Binding #Root.((vm:PeoplePageViewModel)DataContext).RemoveContactCommand}"
												CommandParameter="{Binding}" />
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<TextBlock Text="Контакты не найдены"
							   FontSize="13"
							   Foreground="{DynamicResource LabelMuted}"
							   HorizontalAlignment="Center"
							   Margin="0,24">
						<TextBlock.IsVisible>
							<Binding Path="Contacts.Count"
									 Converter="{x:Static ObjectConverters.Equal}"
									 ConverterParameter="0" />
						</TextBlock.IsVisible>
					</TextBlock>
				</StackPanel>
			</ScrollViewer>

			<!-- Правая колонка: поиск пользователей -->
			<ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
				<StackPanel Spacing="12">
					<TextBlock Classes="sectionTitle" Text="Поиск пользователей" />

					<StackPanel Orientation="Horizontal" Spacing="8">
						<TextBox Classes="input"
								 Text="{Binding SearchQuery}"
								 Watermark="Введите имя или email..."
								 Width="280" />
						<Button Classes="secondaryBtn"
								Content="Найти"
								Command="{Binding SearchCommand}" />
					</StackPanel>

					<TextBlock Classes="errorText" Text="{Binding SearchError}"
							   IsVisible="{Binding SearchError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

					<ItemsControl ItemsSource="{Binding SearchResults}">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="um:UserSearchResultDto">
								<Border Classes="personCard" Margin="0,0,0,8">
									<Grid ColumnDefinitions="*,Auto">
										<StackPanel Grid.Column="0" Spacing="2">
											<TextBlock Text="{Binding Name}"
													   FontSize="14"
													   FontWeight="SemiBold"
													   Foreground="{DynamicResource LabelPrimary}" />
											<TextBlock Text="{Binding Email}"
													   FontSize="13"
													   Foreground="{DynamicResource LabelSecondary}" />
										</StackPanel>
										<Button Grid.Column="1"
												Classes="secondaryBtn"
												Content="В календарь"
												Command="{Binding #Root.((vm:PeoplePageViewModel)DataContext).OpenAddToCalendarCommand}"
												CommandParameter="{Binding}" />
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<TextBlock Text="Введите запрос для поиска пользователей"
							   FontSize="13"
							   Foreground="{DynamicResource LabelMuted}"
							   HorizontalAlignment="Center"
							   Margin="0,24">
						<TextBlock.IsVisible>
							<Binding Path="SearchResults.Count"
									 Converter="{x:Static ObjectConverters.Equal}"
									 ConverterParameter="0" />
						</TextBlock.IsVisible>
					</TextBlock>
				</StackPanel>
			</ScrollViewer>
		</Grid>

		<!-- ═══════ Модальные диалоги ═══════ -->

		<!-- Добавить контакт -->
		<Panel Background="#66000000"
			   IsVisible="{Binding IsAddContactOpen}"
			   ZIndex="100">
			<Border Background="{DynamicResource SurfaceBackground}"
					CornerRadius="16"
					Padding="24"
					Width="400"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					BoxShadow="0 8 32 0 #22000000">
				<StackPanel Spacing="16">
					<TextBlock Text="Добавить контакт"
							   FontSize="18"
							   FontWeight="SemiBold"
							   Foreground="{DynamicResource LabelPrimary}" />

					<StackPanel Spacing="4">
						<TextBlock Text="Email" FontSize="12"
								   Foreground="{DynamicResource LabelSecondary}" />
						<TextBox Classes="input"
								 Text="{Binding NewContactEmail}"
								 Watermark="user@example.com" />
					</StackPanel>

					<StackPanel Spacing="4">
						<TextBlock Text="Псевдоним (необязательно)" FontSize="12"
								   Foreground="{DynamicResource LabelSecondary}" />
						<TextBox Classes="input"
								 Text="{Binding NewContactNickname}"
								 Watermark="Как вам удобно называть" />
					</StackPanel>

					<Grid ColumnDefinitions="*,*">
						<Button Grid.Column="0"
								Content="Отмена"
								Command="{Binding CloseAddContactCommand}"
								Margin="0,0,8,0"
								Background="Transparent"
								BorderBrush="{DynamicResource BorderSoft}"
								BorderThickness="1"
								CornerRadius="8"
								Padding="0,8" />
						<Button Grid.Column="1"
								Classes="primaryBtn"
								Content="Добавить"
								Command="{Binding AddContactCommand}" />
					</Grid>
				</StackPanel>
			</Border>
		</Panel>

		<!-- Добавить в календарь -->
		<Panel Background="#66000000"
			   IsVisible="{Binding IsAddToCalendarOpen}"
			   ZIndex="100">
			<Border Background="{DynamicResource SurfaceBackground}"
					CornerRadius="16"
					Padding="24"
					Width="420"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					BoxShadow="0 8 32 0 #22000000">
				<StackPanel Spacing="16">
					<TextBlock Text="{Binding AddToCalendarTitle}"
							   FontSize="18"
							   FontWeight="SemiBold"
							   Foreground="{DynamicResource LabelPrimary}"
							   TextWrapping="Wrap" />

					<StackPanel Spacing="4">
						<TextBlock Text="Календарь" FontSize="12"
								   Foreground="{DynamicResource LabelSecondary}" />
						<ComboBox ItemsSource="{Binding Calendars}"
								  SelectedItem="{Binding SelectedCalendar}"
								  HorizontalAlignment="Stretch"
								  Background="{DynamicResource SurfaceBackground}"
								  BorderBrush="{DynamicResource BorderSoft}"
								  CornerRadius="8"
								  Padding="10,6">
							<ComboBox.ItemTemplate>
								<DataTemplate x:DataType="cm:CalendarDto">
									<TextBlock Text="{Binding Name}" />
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
					</StackPanel>

					<StackPanel Spacing="4">
						<TextBlock Text="Уровень доступа" FontSize="12"
								   Foreground="{DynamicResource LabelSecondary}" />
						<ComboBox ItemsSource="{Binding AccessLevels}"
								  SelectedItem="{Binding SelectedAccessLevel}"
								  HorizontalAlignment="Stretch"
								  Background="{DynamicResource SurfaceBackground}"
								  BorderBrush="{DynamicResource BorderSoft}"
								  CornerRadius="8"
								  Padding="10,6">
							<ComboBox.ItemTemplate>
								<DataTemplate x:DataType="vm:AccessLevelOption">
									<TextBlock Text="{Binding DisplayName}" />
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
					</StackPanel>

					<Grid ColumnDefinitions="*,*">
						<Button Grid.Column="0"
								Content="Отмена"
								Command="{Binding CloseAddToCalendarCommand}"
								Margin="0,0,8,0"
								Background="Transparent"
								BorderBrush="{DynamicResource BorderSoft}"
								BorderThickness="1"
								CornerRadius="8"
								Padding="0,8" />
						<Button Grid.Column="1"
								Classes="primaryBtn"
								Content="Добавить"
								Command="{Binding AddToCalendarCommand}" />
					</Grid>
				</StackPanel>
			</Border>
		</Panel>
	</Grid>
</UserControl>

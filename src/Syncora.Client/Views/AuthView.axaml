<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Syncora.Client.ViewModels"
             x:Class="Syncora.Client.Views.AuthView"
             x:DataType="vm:AuthViewModel">

    <Grid Background="{DynamicResource WindowBackground}">
        <ScrollViewer x:Name="AuthScrollViewer"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Padding="24,28,24,32">
            <Grid MinHeight="{Binding Viewport.Height, ElementName=AuthScrollViewer}">
                <Border Background="{DynamicResource SurfaceBackground}"
                        Width="480"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        CornerRadius="16"
                        BoxShadow="0 8 32 0 #1A000000"
                        Padding="40,44">

                <StackPanel Spacing="16">
                    <!-- Logo -->
                    <Image Source="/Assets/logo.png"
                           RenderOptions.BitmapInterpolationMode="HighQuality"
                           Width="100" Height="100"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4" />

                    <!-- Header -->
                    <StackPanel Spacing="8" Margin="0,0,0,4">
                        <TextBlock Text="{Binding HeaderTitle}"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource LabelPrimary}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" />

                        <TextBlock Text="{Binding Subtitle}"
                                   FontSize="14"
                                   Foreground="{DynamicResource LabelSecondary}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="360"
                                   LineHeight="22" />
                    </StackPanel>

                    <!-- Name (Registration Only) -->
                    <StackPanel Spacing="6"
                                IsVisible="{Binding !IsLoginMode}">
                        <TextBlock Text="Имя"
                                   FontSize="13"
                                   Foreground="{DynamicResource LabelSecondary}" />
                        <TextBox Text="{Binding Name}"
                                 CornerRadius="10"
                                 BorderBrush="{DynamicResource BorderSoft}"
                                 Padding="12,10"
                                 Watermark="Ваше имя" />
                    </StackPanel>

                    <!-- Email -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Электронная почта"
                                   FontSize="13"
                                   Foreground="{DynamicResource LabelSecondary}" />
                        <TextBox Text="{Binding Email}"
                                 CornerRadius="10"
                                 BorderBrush="{DynamicResource BorderSoft}"
                                 Padding="12,10"
                                 Watermark="name@example.com" />
                    </StackPanel>

                    <!-- Password -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Пароль"
                                   FontSize="13"
                                   Foreground="{DynamicResource LabelSecondary}" />
                        <TextBox Text="{Binding Password}"
                                 PasswordChar="•"
                                 CornerRadius="10"
                                 BorderBrush="{DynamicResource BorderSoft}"
                                 Padding="12,10"
                                 Watermark="Введите пароль" />
                    </StackPanel>

                    <!-- Confirm Password (Registration Only) -->
                    <StackPanel Spacing="6"
                                IsVisible="{Binding !IsLoginMode}">
                        <TextBlock Text="Подтвердите пароль"
                                   FontSize="13"
                                   Foreground="{DynamicResource LabelSecondary}" />
                        <TextBox Text="{Binding ConfirmPassword}"
                                 PasswordChar="•"
                                 CornerRadius="10"
                                 BorderBrush="{DynamicResource BorderSoft}"
                                 Padding="12,10"
                                 Watermark="Повторите пароль" />
                    </StackPanel>

                    <!-- Remember Me (Login Only) -->
                    <CheckBox IsChecked="{Binding RememberMe}"
                              Content="Запомнить меня"
                              IsVisible="{Binding IsLoginMode}"
                              IsEnabled="{Binding !IsLoading}"
                              Foreground="{DynamicResource LabelSecondary}"
                              FontSize="13"
                              Margin="0,2,0,0" />

                    <!-- Error Message -->
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#D32F2F"
                               FontSize="12"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               TextWrapping="Wrap" />

                    <!-- Submit Button -->
                    <Button Command="{Binding SubmitCommand}"
                            Background="{DynamicResource AccentPurple}"
                            Foreground="White"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            CornerRadius="10"
                            Padding="0,14"
                            Margin="0,4,0,0"
                            IsEnabled="{Binding !IsLoading}">
                        <Panel>
                            <TextBlock Text="{Binding SubmitButtonText}"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       IsVisible="{Binding !IsLoading}" />
                            <TextBlock Text="Загрузка..."
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       IsVisible="{Binding IsLoading}" />
                        </Panel>
                    </Button>

                    <!-- Toggle Mode -->
                    <Button Command="{Binding ToggleModeCommand}"
                            Background="Transparent"
                            Foreground="{DynamicResource AccentPurple}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Cursor="Hand"
                            Padding="0,8"
                            IsEnabled="{Binding !IsLoading}">
                        <TextBlock Text="{Binding ToggleModeText}"
                                   FontSize="13" />
                    </Button>
                </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Syncora.Client.ViewModels"
             x:Class="Syncora.Client.Views.AuthView"
             x:DataType="vm:AuthViewModel">

    <Grid Background="{DynamicResource WindowBackground}">
        <Border Background="{DynamicResource SurfaceBackground}"
                Width="380"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                CornerRadius="16"
                BoxShadow="0 8 32 0 #1A000000"
                Padding="40,48">
            
            <StackPanel Spacing="16">
                <!-- Logo / Icon -->
                <PathIcon Data="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM10 17L5 12L6.41 10.59L10 14.17L17.59 6.58L19 8L10 17Z"
                          Foreground="{DynamicResource AccentPurple}"
                          Width="48" Height="48"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,8" />

                <!-- Header -->
                <TextBlock Text="{Binding HeaderTitle}"
                           FontSize="24" 
                           FontWeight="Bold"
                           Foreground="{DynamicResource LabelPrimary}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16" />

                <!-- Name (Registration Only) -->
                <StackPanel Spacing="4"
                            IsVisible="{Binding !IsLoginMode}">
                    <TextBlock Text="Имя" 
                               FontSize="13" 
                               Foreground="{DynamicResource LabelSecondary}"/>
                    <TextBox Text="{Binding Name}"
                             CornerRadius="8"
                             BorderBrush="{DynamicResource BorderSoft}"
                             Padding="10,8"
                             Watermark="Ваше имя" />
                </StackPanel>

                <!-- Email -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Электронная почта" 
                               FontSize="13" 
                               Foreground="{DynamicResource LabelSecondary}"/>
                    <TextBox Text="{Binding Email}"
                             CornerRadius="8"
                             BorderBrush="{DynamicResource BorderSoft}"
                             Padding="10,8"
                             Watermark="name@example.com" />
                </StackPanel>

                <!-- Password -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Пароль" 
                               FontSize="13" 
                               Foreground="{DynamicResource LabelSecondary}"/>
                    <TextBox Text="{Binding Password}"
                             PasswordChar="•"
                             CornerRadius="8"
                             BorderBrush="{DynamicResource BorderSoft}"
                             Padding="10,8"
                             Watermark="Введите пароль" />
                </StackPanel>

                <!-- Confirm Password (Registration Only) -->
                <StackPanel Spacing="4" 
                            IsVisible="{Binding !IsLoginMode}">
                    <TextBlock Text="Подтвердите пароль" 
                               FontSize="13" 
                               Foreground="{DynamicResource LabelSecondary}"/>
                    <TextBox Text="{Binding ConfirmPassword}"
                             PasswordChar="•"
                             CornerRadius="8"
                             BorderBrush="{DynamicResource BorderSoft}"
                             Padding="10,8"
                             Watermark="Повторите пароль" />
                </StackPanel>

                <!-- Error Message -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#D32F2F"
                           FontSize="12"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           TextWrapping="Wrap" />

                <!-- Submit Button -->
                <Button Command="{Binding SubmitCommand}"
                        Background="{DynamicResource AccentPurple}"
                        Foreground="White"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        CornerRadius="8"
                        Padding="0,12"
                        Margin="0,16,0,0"
                        IsEnabled="{Binding !IsLoading}">
                    <Panel>
                        <TextBlock Text="{Binding SubmitButtonText}"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   IsVisible="{Binding !IsLoading}" />
                        <TextBlock Text="Загрузка..."
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   IsVisible="{Binding IsLoading}" />
                    </Panel>
                </Button>

                <!-- Toggle Mode -->
                <Button Command="{Binding ToggleModeCommand}"
                        Background="Transparent"
                        Foreground="{DynamicResource AccentPurple}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Cursor="Hand"
                        Padding="0,8"
                        IsEnabled="{Binding !IsLoading}">
                    <TextBlock Text="{Binding ToggleModeText}"
                               FontSize="13" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Syncora.Client.ViewModels"
             x:Class="Syncora.Client.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <Grid Background="{DynamicResource WindowBackground}">
        <Border Background="{DynamicResource SurfaceBackground}"
                Width="420"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                CornerRadius="16"
                BoxShadow="0 8 32 0 #1A000000"
                Padding="40,44">

            <StackPanel Spacing="20">
                <Image Source="/Assets/logo.png"
                       RenderOptions.BitmapInterpolationMode="HighQuality"
                       Width="72" Height="72"
                       HorizontalAlignment="Center" />

                <TextBlock Text="{Binding WelcomeMessage}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource LabelPrimary}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />

                <TextBlock Text="{Binding LoadingMessage}"
                           FontSize="14"
                           Foreground="{DynamicResource LabelSecondary}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />

                <ProgressBar Value="{Binding LoadingProgress}"
                             Minimum="0"
                             Maximum="100"
                             Height="6"
                             CornerRadius="3"
                             Foreground="{DynamicResource AccentPurple}"
                             Background="{DynamicResource AccentPurpleLight}" />

                <TextBlock Text="{Binding LoadingProgress, StringFormat={}{0:0}%}"
                           FontSize="12"
                           Foreground="{DynamicResource LabelMuted}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

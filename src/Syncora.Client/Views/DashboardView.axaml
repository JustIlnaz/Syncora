<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Syncora.Client.ViewModels"
             x:Class="Syncora.Client.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <Grid Background="{DynamicResource WindowBackground}">
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="16">

            <PathIcon Data="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM10 17L5 12L6.41 10.59L10 14.17L17.59 6.58L19 8L10 17Z"
                      Foreground="{DynamicResource AccentPurple}"
                      Width="64" Height="64"
                      HorizontalAlignment="Center" />

            <TextBlock Text="{Binding WelcomeMessage}"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="{DynamicResource LabelPrimary}"
                       HorizontalAlignment="Center" />

            <TextBlock Text="Вы успешно вошли в Syncora"
                       FontSize="16"
                       Foreground="{DynamicResource LabelSecondary}"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>


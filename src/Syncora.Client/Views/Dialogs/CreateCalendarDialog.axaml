<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Syncora.Client.ViewModels.Dialogs"
             xmlns:cal="using:Syncora.Client.Models.Calendar"
             x:Class="Syncora.Client.Views.Dialogs.CreateCalendarDialogView"
             x:DataType="vm:CreateCalendarDialogViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.titleLabel">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}" />
        </Style>

        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource LabelSecondary}" />
        </Style>

        <Style Selector="TextBox.input">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
        </Style>

        <Style Selector="Button.colorSwatch">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.colorSwatch:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceSecondary}" />
        </Style>

        <Style Selector="Button.colorSwatch.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPurple}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <!-- Стили кнопок primaryBtn/secondaryBtn — глобальные, см. Styles/Buttons.axaml -->

        <Style Selector="TextBlock.errorText">
            <Setter Property="Foreground" Value="#D32F2F" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource WindowBackground}"
            CornerRadius="16"
            BoxShadow="0 8 32 0 #1A000000"
            Padding="32"
            Width="420">
        <StackPanel Spacing="20">
            <!-- Заголовок -->
            <TextBlock Classes="titleLabel" Text="Новый календарь" />

            <!-- Ошибка -->
            <TextBlock Classes="errorText"
                       Text="{Binding ErrorMessage}"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <!-- Название -->
            <StackPanel Spacing="6">
                <TextBlock Classes="label" Text="Название" />
                <TextBox Classes="input"
                         Text="{Binding Name}"
                         Watermark="Мой календарь" />
            </StackPanel>

            <!-- Тип календаря -->
            <StackPanel Spacing="6">
                <TextBlock Classes="label" Text="Тип" />
                <ComboBox ItemsSource="{Binding CalendarTypes}"
                          SelectedItem="{Binding SelectedType}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="cal:CalendarTypeOption">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding DisplayName}" 
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="Личный календарь создаётся автоматически при регистрации"
                           FontSize="11"
                           Foreground="{DynamicResource LabelMuted}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- Цвет -->
            <StackPanel Spacing="6">
                <TextBlock Classes="label" Text="Цвет" />
                <ItemsControl ItemsSource="{Binding CalendarColors}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Button Classes="colorSwatch"
                                    Command="{Binding $parent[UserControl].((vm:CreateCalendarDialogViewModel)DataContext).SelectColorCommand}"
                                    CommandParameter="{Binding}"
                                    Margin="0,0,8,8">
                                <Border Width="24"
                                        Height="24"
                                        CornerRadius="12"
                                        Background="{Binding}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Кнопки -->
            <StackPanel Orientation="Horizontal"
                        Spacing="12"
                        HorizontalAlignment="Right"
                        Margin="0,8,0,0">
                <Button Classes="secondaryBtn"
                        Content="Отмена"
                        Command="{Binding CancelCommand}" />
                <Button Classes="primaryBtn"
                        Command="{Binding CreateCommand}"
                        IsEnabled="{Binding CanCreate}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Создать" />
                        <TextBlock Text="..." IsVisible="{Binding IsCreating}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
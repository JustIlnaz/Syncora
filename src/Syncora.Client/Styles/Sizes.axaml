<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:Double x:Key="SidebarWidth">240</x:Double>
    <x:Double x:Key="SidebarCompactWidth">72</x:Double>
    <x:Double x:Key="SidebarMinWidth">220</x:Double>
    <x:Double x:Key="SidebarMaxWidth">260</x:Double>
    <Thickness x:Key="PagePadding">20</Thickness>
    <x:Double x:Key="NavItemHeight">36</x:Double>
    <x:Double x:Key="NavItemRadius">8</x:Double>
    <x:Double x:Key="CompactBreakpoint">960</x:Double>
    <x:Double x:Key="ProfileAvatarSize">40</x:Double>
    <x:Double x:Key="ProfileAvatarCompactSize">36</x:Double>
    <Thickness x:Key="ProfileCardPadding">12,10</Thickness>
    <Thickness x:Key="ProfileCardCompactPadding">8</Thickness>
</ResourceDictionary>

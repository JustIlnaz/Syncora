<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Syncora.Client.App"
             xmlns:local="using:Syncora.Client"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Syncora.Client/Styles/Colors.axaml"/>
                <ResourceInclude Source="avares://Syncora.Client/Styles/Sizes.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Syncora.Client/Styles/Buttons.axaml"/>
        <Style Selector="CalendarDatePicker">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="CalendarDatePicker:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceSecondary}" />
        </Style>
        <Style Selector="Calendar">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}" />
        </Style>
        <Style Selector="CalendarDayButton:selected">
            <Setter Property="Background" Value="{DynamicResource AccentPurple}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TimePicker">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="MinuteIncrement" Value="15" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Name="LayoutRoot">
                        <Button x:Name="PART_FlyoutButton"
                                Foreground="{TemplateBinding Foreground}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                IsEnabled="{TemplateBinding IsEnabled}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Center">
                            <Grid Name="PART_FlyoutButtonContentGrid" ColumnDefinitions="*,Auto,*">
                                <Border x:Name="PART_FirstPickerHost" Grid.Column="0"
                                        MinWidth="24"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch">
                                    <TextBlock x:Name="PART_HourTextBlock"
                                               Text="{Binding SelectedTime, RelativeSource={RelativeSource TemplatedParent}, StringFormat='hh'}"
                                               HorizontalAlignment="Center" />
                                </Border>
                                <Rectangle Name="PART_FirstColumnDivider"
                                           Grid.Column="1"
                                           Fill="{DynamicResource TimePickerSpacerFill}"
                                           HorizontalAlignment="Center"
                                           Width="1" />
                                <Border x:Name="PART_SecondPickerHost" Grid.Column="2"
                                        MinWidth="24"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch">
                                    <TextBlock x:Name="PART_MinuteTextBlock"
                                               Text="{Binding SelectedTime, RelativeSource={RelativeSource TemplatedParent}, StringFormat='mm'}"
                                               HorizontalAlignment="Center" />
                                </Border>
                                <Rectangle Name="PART_SecondColumnDivider"
                                           Grid.Column="3"
                                           Fill="{DynamicResource TimePickerSpacerFill}"
                                           HorizontalAlignment="Center"
                                           Width="1" />
                                <Border x:Name="PART_ThirdPickerHost" Grid.Column="4"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch">
                                    <TextBlock x:Name="PART_SecondTextBlock"
                                               HorizontalAlignment="Center" />
                                </Border>
                                <Rectangle Name="PART_ThirdColumnDivider"
                                           Grid.Column="5"
                                           Fill="{DynamicResource TimePickerSpacerFill}"
                                           HorizontalAlignment="Center"
                                           Width="1" />
                                <Border x:Name="PART_FourthPickerHost" Grid.Column="6"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch">
                                    <TextBlock x:Name="PART_PeriodTextBlock"
                                               HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Button>
                        <Popup Name="PART_Popup"
                               WindowManagerAddShadowHint="False"
                               IsLightDismissEnabled="True"
                               PlacementTarget="{TemplateBinding}"
                               Placement="Bottom">
                            <TimePickerPresenter Name="PART_PickerPresenter" />
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="TimePicker:pointerover /template/ Button#PART_FlyoutButton">
            <Setter Property="Background" Value="{DynamicResource SurfaceSecondary}" />
        </Style>
        <Style Selector="TimePicker:disabled /template/ Button#PART_FlyoutButton TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource LabelMuted}" />
        </Style>
    </Application.Styles>
</Application>

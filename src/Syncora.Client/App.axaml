<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Syncora.Client.App"
             xmlns:local="using:Syncora.Client"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Syncora.Client/Styles/Colors.axaml"/>
                <ResourceInclude Source="avares://Syncora.Client/Styles/Sizes.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
        <Style Selector="CalendarDatePicker">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="CalendarDatePicker:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceSecondary}" />
        </Style>
        <Style Selector="Calendar">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}" />
        </Style>
        <Style Selector="CalendarDayButton:selected">
            <Setter Property="Background" Value="{DynamicResource AccentPurple}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TimePicker">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="TimePicker:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceSecondary}" />
        </Style>
    </Application.Styles>
</Application>
